[Desktop Entry]
Name=LunaSurfer
Comment=QtWebEngine web browser
Exec=lunasurfer %U
Icon=web-browser
Terminal=false
Type=Application
Categories=Network;WebBrowser;
StartupNotify=true
MimeType=application/pdf;application/x-pdf;text/html;application/xhtml+xml;x-scheme-handler/http;x-scheme-handler/https;
